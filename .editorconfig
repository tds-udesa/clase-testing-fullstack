root = true

[*]
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8

[*.py]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# All script files
[*.{bash,bat,bats,cmd,ps1,psm1,sh}]
indent_size = 4

# Shell script files
[*.sh]
end_of_line = lf